<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_top_app_bar"
        android:minHeight="72dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:navigationContentDescription="@string/reports_map_back"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:subtitle="@string/reports_map_subtitle"
        app:subtitleTextColor="@color/text_secondary"
        app:title="@string/reports_map_title"
        app:titleTextColor="@color/text_primary" />

    <WebView
        android:id="@+id/reportsMap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
